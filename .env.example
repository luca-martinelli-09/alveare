# Immagini: con le release su GHCR, per esempio
# ALVEARE_REGISTRY=ghcr.io/<owner>/alveare e ALVEARE_VERSION=v0.1.0 (mai latest).
ALVEARE_REGISTRY=alveare
ALVEARE_VERSION=dev

# Copia in .env e compila. Genera la chiave con: openssl rand -base64 32
ALVEARE_SECRET_KEY=
MARIADB_ROOT_PASSWORD=
# Email del primo admin: al primo avvio la password temporanea compare nei log del pannello.
ALVEARE_ADMIN_EMAIL=
# Hostname del pannello (servito da Caddy, da proteggere con Cloudflare Access).
ALVEARE_PANEL_HOST=
# Hostname di Adminer (anche questo dietro Cloudflare Access). Vuoto = Adminer spento.
ALVEARE_ADMINER_HOST=

# Copiati senza prefisso nel .env di ogni sito: SMTP di AWS SES.
SITE_ENV_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SITE_ENV_SMTP_PORT=587
SITE_ENV_SMTP_USER=
SITE_ENV_SMTP_PASSWORD=

# Backup con restic su storage S3-compatibile (default: Cloudflare R2).
RESTIC_REPOSITORY=s3:https://<account>.r2.cloudflarestorage.com/<bucket>/alveare
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Memoria massima di Redis (cache oggetti di WordPress, code di Laravel).
REDIS_MAXMEMORY=256mb

# Avvisi su Telegram (backup falliti, siti irraggiungibili, integrità, budget di memoria).
# Bot creato con @BotFather; chat = id del gruppo o della persona. Vuoti = solo nel pannello.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Spazio per sito (file + database, in MB) oltre il quale parte un avviso.
ALVEARE_DISK_ALERT_MB=10240

# Cloudflare: hostname dei siti sul tunnel (ingress + CNAME) e regole WAF/rate limit via API.
# Un blocco per account, con un'etichetta a scelta (qui BANDA). Token con permessi:
# Account > Cloudflare Tunnel: Edit; Zone > DNS: Edit; Zone > Zone WAF: Edit; Zone > Zone: Read.
# Vuoti = hostname da aggiungere a mano nel tunnel.
CLOUDFLARE_BANDA_API_TOKEN=
CLOUDFLARE_BANDA_ACCOUNT_ID=
CLOUDFLARE_BANDA_TUNNEL_ID=
